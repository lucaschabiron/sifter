{
  "name": "sifter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -w run dev:all",
    "dev:all": "concurrently --names \"front,back\" --prefix-colors \"cyan,magenta\" \"pnpm --filter @sifter/frontend dev\" \"pnpm --filter @sifter/backend dev\"",
    "build": "pnpm -w run build:all",
    "build:all": "pnpm --filter @sifter/frontend build && pnpm --filter @sifter/backend build",
    "lint": "pnpm -w run lint:all",
    "lint:all": "pnpm --filter @sifter/frontend lint && pnpm --filter @sifter/backend lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
